# 部署配置；客户端版本、CDN 认证及 Master key/IV 来自运行时客户端 JSON，无需填写。
# 进程环境变量优先于 .env，不再加载 .env.local。
PENLIGHT_API_KEY=
# 设置后，同一密钥也保护资源更新器使用的 /internal/v1/jp/resources/snapshot；留空则免认证。
# 更新器只把它发送到本站，不会发送到 CDN。
# 一个或多个现有账号凭据文件；多个路径用逗号分隔，填写后自动启用日服在线接口。
PENLIGHT_JP_ACCOUNTS=secrets/jp-account.json

# Master 模式：local（读取已导入数据）、download（自动下载）、sync（从其他实例同步）。
PENLIGHT_JP_MASTER_MODE=local
# 默认读取 artifacts/jp/master-store，无需重复填写。
# PENLIGHT_JP_MASTER_DIR=artifacts/jp/master-store

# download 模式直接使用运行时 JSON 中的 CDN 认证和 Master key/IV。
# 默认每 300 秒检查，失败保留已有快照。

# 默认监听 127.0.0.1:8081；其他参数均有默认值，见 docs/configuration.md。
# PENLIGHT_LISTEN=127.0.0.1:8081
# RUST_LOG=info

# 默认使用 main 合并后自动发布的预编译镜像；可固定 sha-<commit> 标签回滚。
# PENLIGHT_IMAGE=ghcr.io/lanyinn-labs/penlight-notes-api:main

# Docker 启动/重启时拉取最新客户端 JSON；失败使用持久缓存。
# 设为空可关闭远程拉取，固定当前缓存配置。
# PENLIGHT_CLIENT_CONFIG_URL=
# 独立二进制默认读取 data/jp-client.json，可指定其他路径。
# PENLIGHT_CLIENT_CONFIG=data/jp-client.json
