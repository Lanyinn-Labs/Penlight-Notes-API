# HTTP 服务
HOST=127.0.0.1
PORT=8081
RUST_LOG=info

# API 访问密钥。留空时关闭认证；仅适用于 /api/*。
# 支持 X-API-Key: <key> 或 Authorization: Bearer <key>。
API_KEY=

# 国际服
# ENABLED 控制区服启用状态。游戏协议尚未实现。
OURNOTES_GLOBAL_ENABLED=true
# 客户端版本取自安装包文件名，尚未通过 AndroidManifest 验证。
OURNOTES_GLOBAL_CLIENT_VERSION=1.0.1
# 游戏服务地址。预留配置项，当前版本不发起上游请求。
OURNOTES_GLOBAL_BASE_URL=

# 日服
OURNOTES_JP_ENABLED=false
OURNOTES_JP_CLIENT_VERSION=
OURNOTES_JP_BASE_URL=
