# HTTP 服务
HOST=127.0.0.1
PORT=8081
RUST_LOG=info

# API 访问密钥。留空时公共接口免认证，但 /user/* 不可访问。
# 支持 X-API-Key: <key> 或 Authorization: Bearer <key>。
API_KEY=

# 活动榜线缓存。避免频繁请求；活动开放后再按实际行为调整。
RANKING_CACHE_TTL_SECS=30
RANKING_STALE_TTL_SECS=300
RANKING_RETRY_DELAY_SECS=5

# 国际服
# ENABLED 控制区服启用状态。游戏协议尚未实现。
OURNOTES_GLOBAL_ENABLED=true
# 客户端版本已由 AndroidManifest 验证。
OURNOTES_GLOBAL_CLIENT_VERSION=1.0.1
# 历史地址配置；单独设置不能启用在线请求。
OURNOTES_GLOBAL_BASE_URL=
# 可选：仅用于本地 Master 快照查询，与实时榜线无关。
# OURNOTES_GLOBAL_MASTER_DIR=

# 日服
OURNOTES_JP_ENABLED=true
OURNOTES_JP_CLIENT_VERSION=1.0.2
OURNOTES_JP_BASE_URL=
# 默认读取 artifacts/jp/master-decrypted；部署时可设置挂载后的路径。
# OURNOTES_JP_MASTER_DIR=

# 进程内复用 Sirius 日服协议；复制 config/jp.example.json 并设置现有账号凭据。
# OURNOTES_JP_PROTOCOL_CONFIG=config/jp.local.json

# Master 自动下载：使用 config/jp.master-update.example.json 中的配置。
# 需从已验证的客户端/资源认证记录配置以下值；缺少时保持自动下载关闭。
# SIRIUS_CDN_USERNAME=
# SIRIUS_CDN_CREDENTIAL=
# SIRIUS_MASTER_KEY_HEX=
# SIRIUS_MASTER_IV_HEX=
