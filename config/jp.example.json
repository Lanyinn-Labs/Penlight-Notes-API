{
  "region": "jp",
  "platform": "Android",
  "environment": "release",
  "endpoint": "https://api.bang-dream-on.jp",
  "client_version": "1.0.2",
  "session_lock": true,
  "protocol_directory": "vendor/sirius-api-proxy/protocol/sirius/1.0.3",
  "api_token_env": "SIRIUS_API_TOKEN",
  "internal_token_env": "SIRIUS_INTERNAL_TOKEN",
  "accounts": [
    {"name": "existing", "credentials_file": "/run/secrets/jp-account.json"}
  ],
  "master_directory": "artifacts/jp/master-store",
  "default_cdn_root": "https://static.bang-dream-on.jp",
  "cdn_credential_env": {
    "https://static.bang-dream-on.jp": "SIRIUS_CDN_CREDENTIAL"
  }
}
